---
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].skills;
---

<section class="section skills" id="conhecimentos" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow mono" data-reveal>{t.eyebrow}</p>
      <h2 class="h2" id="skills-title" data-reveal>{t.title}</h2>
    </div>

    <div class="groups">
      {t.groups.map((g) => (
        <div class="group" data-reveal>
          <h3 class="group__name">{g.name}</h3>
          <p class="group__note">{g.note}</p>
          <ul class="chips" role="list">
            {g.items.map((item) => <li class="chip mono">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .group {
    padding: 2rem clamp(1rem, 2vw, 2rem) 2.5rem 0;
  }

  .group + .group {
    padding-left: clamp(1rem, 2vw, 2rem);
    border-left: 1px solid var(--line);
  }

  .group__name {
    font-size: var(--fs-h3);
    font-weight: 700;
  }

  .group__note {
    margin-top: 0.5rem;
    max-width: 32ch;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .chip {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 3px;
    color: var(--text);
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .groups {
      grid-template-columns: 1fr;
    }

    .group,
    .group + .group {
      padding: 2rem 0;
      border-left: 0;
    }

    .group + .group {
      border-top: 1px solid var(--line);
    }
  }
</style>
