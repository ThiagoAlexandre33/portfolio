---
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const home = lang === 'pt' ? '/' : '/en/';
---

<header class="header" data-header>
  <div class="header__inner wrap">
    <a class="brand" href={home} aria-label="Thiago Alexandre — início">
      <span class="brand__mark mono" aria-hidden="true">[TA]</span>
      <span class="brand__name">Thiago Alexandre</span>
    </a>

    <nav class="nav" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
      <ul class="nav__list" role="list" data-nav-list>
        {t.nav.items.map((item) => (
          <li>
            <a class="nav__link" href={`#${item.id}`} data-nav-link={item.id}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <button
        class="tool tool--sound"
        type="button"
        aria-pressed="false"
        data-sound-toggle
        data-label-on={t.nav.sound.on}
        data-label-off={t.nav.sound.off}
      >
        <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="visually-hidden" data-sound-label>{t.nav.sound.off}</span>
      </button>

      <div class="lang" role="group" aria-label={t.nav.langLabel}>
        <a class="lang__opt mono" href="/" hreflang="pt-BR" lang="pt-BR" aria-current={lang === 'pt' ? 'true' : undefined}>PT</a>
        <a class="lang__opt mono" href="/en/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </div>

      <button class="tool tool--menu" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-toggle>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu-mobile" data-menu hidden>
    <ul role="list" class="menu__list">
      {t.nav.items.map((item) => (
        <li>
          <a class="menu__link" href={`#${item.id}`} data-menu-link>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background-color var(--dur) ease, border-color var(--dur) ease;
    border-bottom: 1px solid transparent;
  }

  .header.is-scrolled {
    background: rgb(10 12 15 / 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    min-height: 44px;
  }

  .brand__mark {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .brand__name {
    font-weight: 650;
    font-size: 0.95rem;
  }

  .nav {
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    gap: 0.25rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.85rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .nav__link:hover,
  .nav__link[aria-current='true'] {
    color: var(--text);
  }

  .nav__link[aria-current='true']::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tool {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--dur-fast) ease;
  }

  .tool:hover {
    border-color: var(--ice);
  }

  .sound-bars {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 14px;
  }

  .sound-bars i {
    width: 2px;
    height: 3px;
    background: var(--text-muted);
    transition: height var(--dur) var(--ease-out);
  }

  .tool--sound[aria-pressed='true'] .sound-bars i {
    background: var(--accent);
    animation: bar 1.1s ease-in-out infinite alternate;
  }

  .tool--sound[aria-pressed='true'] .sound-bars i:nth-child(2) { animation-delay: -0.4s; }
  .tool--sound[aria-pressed='true'] .sound-bars i:nth-child(3) { animation-delay: -0.8s; }
  .tool--sound[aria-pressed='true'] .sound-bars i:nth-child(4) { animation-delay: -0.2s; }

  @keyframes bar {
    from { height: 3px; }
    to { height: 14px; }
  }

  .lang {
    display: flex;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px;
  }

  .lang__opt {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    height: 36px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-muted);
  }

  .lang__opt[aria-current='true'] {
    background: var(--text);
    color: var(--bg);
  }

  .tool--menu {
    display: none;
  }

  .menu-icon {
    display: grid;
    gap: 5px;
  }

  .menu-icon i {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out);
  }

  [aria-expanded='true'] .menu-icon i:first-child { transform: translateY(3.25px) rotate(45deg); }
  [aria-expanded='true'] .menu-icon i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .menu {
    position: fixed;
    inset: 4.5rem 0 0;
    background: var(--bg);
    padding: 2rem var(--gutter);
    overflow-y: auto;
  }

  .menu__list {
    display: grid;
    gap: 0.25rem;
  }

  .menu__link {
    display: block;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    font-size: 2rem;
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .tools {
      margin-left: auto;
    }

    .tool--menu {
      display: inline-grid;
    }
  }

  @media (max-width: 420px) {
    .brand__name {
      display: none;
    }
  }
</style>
